.screen {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
}

.panel {
    width: 640px;
    padding: 32px;
    border-radius: 12px;
    background-color: rgba(20, 20, 24, 0.85);
}

.title {
    font-size: 64px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: rgb(240, 200, 120);
    margin-bottom: 24px;
}

.subtitle {
    font-size: 28px;
    -unity-text-align: middle-center;
    color: rgb(220, 220, 220);
    margin-bottom: 16px;
}

.menu-button {
    height: 64px;
    font-size: 28px;
    margin: 8px 0;
}

.code-row {
    flex-direction: row;
    margin: 8px 0;
}

.code-row > TextField {
    flex-grow: 1;
    font-size: 28px;
    margin: 0 8px 0 0;
}

.code-row > .menu-button {
    width: 200px;
    margin: 0;
}

.status {
    font-size: 22px;
    -unity-text-align: middle-center;
    color: rgb(255, 160, 140);
    margin-top: 16px;
    white-space: normal;
}

.hint {
    font-size: 22px;
    -unity-text-align: middle-center;
    color: rgb(180, 180, 180);
    margin: 12px 0;
    white-space: normal;
}

.lobby-screen {
    flex-grow: 1;
    flex-direction: row;
    align-items: center;
    padding-left: 48px;
}

.lobby-panel {
    width: 760px;
}

.player-list {
    margin: 8px 0 16px 0;
}

.player-row {
    font-size: 24px;
    padding: 10px 16px;
    margin: 4px 0;
    border-radius: 6px;
    color: rgb(140, 140, 140);
    background-color: rgba(255, 255, 255, 0.05);
}

.player-row--local {
    color: rgb(255, 230, 160);
    background-color: rgba(240, 200, 120, 0.18);
}

.player-row--remote {
    color: rgb(200, 220, 255);
    background-color: rgba(120, 160, 240, 0.18);
}

.hud {
    flex-grow: 1;
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-start;
    padding: 24px;
}

.hud-info {
    font-size: 24px;
    color: rgb(230, 230, 230);
    padding: 8px 16px;
    border-radius: 6px;
    background-color: rgba(20, 20, 24, 0.7);
}

.hud-button {
    font-size: 22px;
    height: 48px;
    padding: 0 24px;
}

.small-button {
    align-self: center;
    font-size: 20px;
    height: 40px;
    padding: 0 20px;
    margin-bottom: 8px;
}

.hud-column {
    align-items: flex-start;
}

.hud-message {
    font-size: 22px;
    color: rgb(255, 190, 150);
    margin-top: 8px;
}
