  m_Name: 
  m_EditorClassIdentifier: OverSmithed.Runtime::OverSmithed.UI.LoadingScreen
  _tips:
  - Throw items to your teammates to save time!
  - 'Keep an eye on the timer: the shift does not wait for anyone.'
  - Fell off the map? You will be back in a few seconds.
  - 'Talk to your team: who forges, who delivers?'
  - Empty hands can catch a thrown item.
  _tipText: {fileID: 7923375276922070653}
  _minimumDuration: 1
  _fadeDuration: 0.25
